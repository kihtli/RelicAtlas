<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0.0</Version>
    <Authors>kihtli</Authors>
    <Company>kihtli</Company>
    <AssemblyTitle>Relic Atlas for Umbra</AssemblyTitle>
    <Description>Live Relic Atlas progress on an Umbra toolbar.</Description>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
    <PathMap>$(MSBuildProjectDirectory)=/_/Umbra.RelicAtlas</PathMap>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DalamudLibPath Condition="'$(DalamudLibPath)' == '' And Exists('$(HOME)/.xlcore/dalamud/Hooks/dev/Dalamud.dll')">$(HOME)/.xlcore/dalamud/Hooks/dev</DalamudLibPath>
    <DalamudLibPath Condition="'$(DalamudLibPath)' == ''">$(APPDATA)/XIVLauncher/addon/Hooks/dev</DalamudLibPath>
    <UmbraLibPath Condition="'$(UmbraLibPath)' == '' And Exists('$(HOME)/.xlcore/installedPlugins/Umbra/3.1.18.0/Umbra.dll')">$(HOME)/.xlcore/installedPlugins/Umbra/3.1.18.0</UmbraLibPath>
    <UmbraLibPath Condition="'$(UmbraLibPath)' == ''">$(APPDATA)/XIVLauncher/installedPlugins/Umbra/3.1.18.0</UmbraLibPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Umbra"><HintPath>$(UmbraLibPath)/Umbra.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Umbra.Common"><HintPath>$(UmbraLibPath)/Umbra.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Una.Drawing"><HintPath>$(UmbraLibPath)/Una.Drawing.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Dalamud"><HintPath>$(DalamudLibPath)/Dalamud.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Lumina"><HintPath>$(DalamudLibPath)/Lumina.dll</HintPath><Private>false</Private></Reference>
    <Compile Include="../RelicAtlas/Interop/RelicSnapshot.cs" Link="Contract/RelicSnapshot.cs" />
  </ItemGroup>
  <Target Name="CheckHostReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(UmbraLibPath)/Umbra.dll')" Text="Set UmbraLibPath to your Umbra 3.1.18.0 installation directory." />
    <Error Condition="!Exists('$(DalamudLibPath)/Dalamud.dll')" Text="Set DalamudLibPath to the Dalamud API 15 reference directory." />
  </Target>
</Project>
